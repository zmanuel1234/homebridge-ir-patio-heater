{
  // Not used for building: the plugin is plain JavaScript. ESLint's type-aware rules (the
  // promise checks) read the code through this file.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["index.js", "lib", "test"]
}
