{
  "name": "homebridge-ir-patio-heater",
  "displayName": "IR Patio Heater (Tuya)",
  "version": "1.3.0",
  "description": "Remote-only patio heaters, driven through a Tuya (Smart Life) IR blaster, in HomeKit: an on/off tile, a power-level slider and an Out of Sync button.",
  "author": "Manuel Zamfir",
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-ir-patio-heater#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-ir-patio-heater.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-ir-patio-heater/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"console.log('Nothing to build: the plugin is plain JavaScript.')\"",
    "check": "tsc -p .",
    "lint": "oxlint",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run verify",
    "verify": "npm run check && npm run lint && npm run build && npm test && node .github/scripts/check-homebridge.mjs && node .github/scripts/check-config-schema.mjs",
    "test:matrix": "npm run build && npm test",
    "release:check": "npm run verify && node .github/scripts/check-homebridge.mjs --release"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "homekit",
    "tuya",
    "infrared",
    "ir",
    "patio",
    "heater",
    "ir-blaster",
    "smart-life",
    "patio-heater",
    "outdoor-heater"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"
  }
}
